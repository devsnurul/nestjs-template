# =============================================================================
# VisaPrime — API Server environment example
# Copy to `.env` and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Postgres connection string (REQUIRED)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/visaprime

# Comma-separated list of allowed browser origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (requests per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Auth / JWT -------------------------------------------------------------
# Change in production; a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-secret-change-in-production

# Access token life (seconds)
JWT_ACCESS_EXPIRY_SEC=900

# Refresh token / session life (seconds, default 7 days)
JWT_REFRESH_EXPIRY_SEC=604800

# --- Mail --------------------------------------------------------------------
# SMTP settings (MailHog default when not configured for dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="VisaPrime" <noreply@visaprime.com>

# Frontend base URL used for building links (reset-password, etc.)
FRONTEND_URL=http://localhost:3000

# --- Redis / BullMQ queues ---------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=visaprime:

# Bull queue prefix
BULL_PREFIX=bull

# --- Object storage (S3-compatible) -----------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=
STORAGE_SIGNED_URL_EXPIRY=3600
STORAGE_ACCESS_MODE=private # private | public-read | hybrid

# --- Socket.IO ---------------------------------------------------------------
SOCKET_PATH=/socket.io
SOCKET_NAMESPACE=/
SOCKET_CORS_ALLOWED_ORIGINS=http://localhost:3000
SOCKET_REDIS_ADAPTER=false # set true to enable Redis socket.io adapter

# --- Async logging (buffered writes to DB) -----------------------------------
LOG_BATCH_SIZE=50
LOG_FLUSH_INTERVAL_MS=2000
LOG_QUEUE_TTL=86400

# --- Twilio SMS (for applicant OTP delivery) ---------------------------------
# Optional — when unset AND NODE_ENV != production, the OTP is returned in the
# response instead of being sent (dev mock). In production, SMS must be
# configured or no OTP can be delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS batch worker tuning
SMS_BATCH_SIZE=10
SMS_FLUSH_INTERVAL_MS=1000
SMS_QUEUE_TTL=3600

# --- Applicant OTP -----------------------------------------------------------
# OTP code length (digits)
OTP_LENGTH=6

# How long a code stays valid (seconds, default 5 min)
OTP_EXPIRY_SECONDS=300

# Minimum wait before the same phone number can request another code
OTP_REQUEST_COOLDOWN_SECONDS=30

# Maximum failed verify attempts before the code is invalidated
OTP_MAX_ATTEMPTS=5

# Default calling code used when a number is entered without one
OTP_DEFAULT_COUNTRY=BD

# SMS body template ({{otp}} and {{expiry_minutes}} placeholders)
OTP_SMS_TEMPLATE=Your verification code is {{otp}}. It will expire in {{expiry_minutes}} minutes.
